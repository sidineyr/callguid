<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="@color/paper">
    <TextView android:id="@+id/exercise_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="@color/ink_green" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/practice_instruction" android:textSize="18sp"
        android:textColor="@color/text_primary" />
    <TextView android:id="@+id/letter_model" android:layout_width="match_parent" android:layout_height="100dp"
        android:gravity="center" android:textSize="62sp" android:textStyle="italic" android:fontFamily="serif"
        android:textColor="@color/accent_ochre" android:contentDescription="@string/model_description" />
    <com.sidineyr.callguide.TraceView android:id="@+id/trace_view"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="220dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/undo_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp"
            android:layout_height="52dp" android:layout_weight="1" android:text="@string/undo" />
        <com.google.android.material.button.MaterialButton android:id="@+id/clear_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp"
            android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/clear" />
        <com.google.android.material.button.MaterialButton android:id="@+id/next_exercise_button"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1.25"
            android:layout_marginStart="8dp" android:text="@string/next_exercise" />
    </LinearLayout>
</LinearLayout>
